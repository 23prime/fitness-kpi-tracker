# Copy to .env and fill in the value for your device. .env is git-ignored.

# Target device for adb and the Gradle install tasks. Take the value from the
# first column of `adb devices`. Wireless debugging also exposes the device as
# an IP:port pair, but that port changes every time wireless debugging is
# toggled, so prefer the mDNS name shown below.
ANDROID_SERIAL=adb-XXXXXXXXXXXXXX-XXXXXX._adb-tls-connect._tcp
