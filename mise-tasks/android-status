#!/usr/bin/env bash
#MISE description="Report device screen lock state, wakefulness, and the foreground app"
#MISE alias="ast"
set -euo pipefail

echo "Wakefulness:"
adb shell dumpsys power | grep mWakefulness || echo "  (not found)"
echo "Keyguard:"
adb shell dumpsys window | grep isKeyguardShowing || echo "  (not found)"
echo "Foreground:"
adb shell dumpsys window | grep mCurrentFocus || echo "  (not found)"
